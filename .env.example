# =============================================================================
# ScamTrace environment template — NAMES ONLY. Never put real secrets here.
# Copy to .env (gitignored) and fill values privately.
# =============================================================================

# --- Supabase (server-side only; never ship to the browser) ---
SUPABASE_URL=
# Prefer SERVICE_ROLE for ingest/ops APIs. Do not reuse as a browser/anon key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback used by some scripts if SERVICE_ROLE is unset (still server-only).
SUPABASE_KEY=

# --- Distinct ops secrets (do NOT reuse the same value across these) ---
# Shared password for /login → ops console. Dedicated password only.
CONSOLE_PASSWORD=
# HMAC signing for scamtrace_session cookies. Dedicated secret; not the console password.
THREAT_SYNC_SECRET=
# Vercel Cron Authorization: Bearer <CRON_SECRET>. Dedicated secret; not the console password.
CRON_SECRET=

# Legacy console-password fallback ONLY if CONSOLE_PASSWORD is unset.
# Do not put a Groq/API key here. Prefer CONSOLE_PASSWORD instead.
# ScamTrace_Engine_Key=

# --- Postgres dumps (local backup scripts only; never commit) ---
# SCAMTRACE_DATABASE_URL=postgresql://postgres.<ref>:<password>@...supabase.com:5432/postgres
# DATABASE_URL=
# DIRECT_URL=

# --- Threat feed APIs (server / Actor only) ---
URLHAUS_API_KEY=
SPAMHAUS_USERNAME=
SPAMHAUS_PASSWORD=
SPAMHAUS_REALM=intel
# Spamhaus Intel API username looks like account@######## (not the portal email alone).

# --- AI Analysis Layer (advisory commentary only; never used for scores) ---
# Dedicated Groq key — must NOT be reused as CONSOLE_PASSWORD / CRON_SECRET / THREAT_SYNC_SECRET.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_ANALYSIS_ENABLED=true

# --- Pipeline controls (CLI default). Vercel Cron sets source per schedule. ---
INGEST_SOURCES=reddit
OPENPHISH_LIMIT=500
OPENPHISH_BATCH_SIZE=50
URLHAUS_LIMIT=300
URLHAUS_BATCH_SIZE=50
SPAMHAUS_LIMIT=75
SPAMHAUS_BATCH_SIZE=25
SPAMHAUS_SEED_DOMAINS=
REDDIT_SOURCE_DELAY_MS=
SUPABASE_WRITE_TIMEOUT_MS=60000
SUPABASE_WRITE_RETRIES=5
SUPABASE_RETRY_BASE_MS=1000
SUPABASE_RETRY_MAX_MS=30000

# Dev-only: allow ?secret= for cron auth. Never enable on production Vercel.
# ALLOW_QUERY_SECRET=1
