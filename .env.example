SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Apify Actor persistence uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (backend only).
# Never expose the service role key to browsers, Dataset output, or logs.

# Optional: Postgres connection string for private local dumps only (never commit).
# SCAMTRACE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-....pooler.supabase.com:5432/postgres
# DATABASE_URL=   # accepted as fallback by scripts/backup-scamtrace-supabase.ps1
# DIRECT_URL=     # accepted as fallback by scripts/backup-scamtrace-supabase.ps1

# Threat intel APIs (same stack as SecureMeBuddy)
URLHAUS_API_KEY=
SPAMHAUS_USERNAME=
SPAMHAUS_PASSWORD=
SPAMHAUS_REALM=intel
# Spamhaus Intel API username looks like account@######## (not the portal email alone).
THREAT_SYNC_SECRET=

# Vercel Cron auth (preferred). Vercel sends: Authorization: Bearer <CRON_SECRET>
# Fall back: THREAT_SYNC_SECRET is also accepted by /api/ingest
CRON_SECRET=

# Ops console login password (preferred). Falls back to ScamTrace_Engine_Key.
CONSOLE_PASSWORD=

# Optional legacy / app keys
# ScamTrace_Engine_Key=   # console password fallback only — prefer CONSOLE_PASSWORD
# GROQ_API_KEY=           # AI Analysis Layer only (advisory). Never used for scoring.
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_ANALYSIS_ENABLED=true  # or Actor input enableAiAnalysis=true

# Pipeline controls (CLI default). Vercel Cron sets source per schedule.
INGEST_SOURCES=reddit
OPENPHISH_LIMIT=500
OPENPHISH_BATCH_SIZE=50
URLHAUS_LIMIT=300
URLHAUS_BATCH_SIZE=50
SPAMHAUS_LIMIT=75
SPAMHAUS_BATCH_SIZE=25
SPAMHAUS_SEED_DOMAINS=
REDDIT_SOURCE_DELAY_MS=
SUPABASE_WRITE_TIMEOUT_MS=60000
SUPABASE_WRITE_RETRIES=5
SUPABASE_RETRY_BASE_MS=1000
SUPABASE_RETRY_MAX_MS=30000
